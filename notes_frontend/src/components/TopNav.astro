---
/**
 * TopNav.astro - Sticky top navigation bar for the Notes App
 */
---
<nav class="top-nav">
  <div class="logo">
    <svg width="29" height="29" fill="none" viewBox="0 0 29 29" style="vertical-align: middle; margin-right: 8px"><rect width="29" height="29" rx="6" fill="var(--color-primary)"/><text x="50%" y="56%" text-anchor="middle" font-size="14" font-family="Inter,sans-serif" fill="#fff" font-weight="700" dy=".3em">📝</text></svg>
    Simple Notes
  </div>
  <slot />
</nav>
<style>
  .top-nav {
    height: var(--nav-height);
    background: var(--color-nav);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border);
    padding: 0 2rem;
    box-shadow: var(--shadow);
    z-index: 10;
  }
  .logo {
    font-size: 1.22rem;
    color: var(--color-primary);
    font-weight: 700;
    letter-spacing: 1.2px;
    display: flex;
    align-items: center;
    user-select: none;
  }
</style>
